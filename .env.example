# Jira
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# A ticket is picked up when it's assigned to you in one of these statuses. They're worked in the order listed.
TRIGGER_STATUSES="Selected for Dev,Backlog"
# A ticket is moved to this status when its run starts.
IN_PROGRESS_STATUS="In Progress"
# true: a ticket that's approved to go live is handed to /go-live. false: approved tickets are left alone.
GO_LIVE=true
# A ticket in this status counts as approved.
APPROVED_STATUS="Approved"
# So does a ticket in one of these, when its latest comment from someone else says it's approved and is meant for you.
REVIEW_STATUSES="Testing,Client Testing"
# Optional. Extra JQL, ANDed onto the search.
# JIRA_EXTRA_JQL='project not in (ABC, XYZ)'
# Optional. Extra JQL, ANDed onto the search for approved tickets only.
# GO_LIVE_EXTRA_JQL='project not in (LMN)'

# Seconds between polls.
POLL_INTERVAL=600
# Each ticket waits a random number of seconds in this range before it starts. Set both to 0 to skip the wait.
DELAY_MIN=900
DELAY_MAX=2700

# true: the plan is approved for you and the run builds, deploys, and hands the ticket off unattended.
# false: each run stops once the plan is written and waits for you to approve it.
AUTO_APPROVE_PLAN=true

# A run is stopped after this many seconds.
RUN_TIMEOUT=7200
# Optional. A run is stopped once it has spent this much, in US dollars.
# MAX_BUDGET_USD=25
# Seconds a local environment gets to start. Its up and down commands in repos.json each get as long.
ENV_TIMEOUT=300

# Optional. Tools a run can never use, on top of the Jira writes the script already refuses. Comma-separated.
# A trailing * takes away a whole MCP server, like a second Jira a run should never reach.
# EXTRA_DISALLOWED_TOOLS="mcp__other-jira__*"

# Optional. The prompt each ticket is handed to. {key} becomes the ticket key.
# AGENT_PROMPT="/ticket {key}"
# GO_LIVE_PROMPT="/go-live {key}"
# Optional. What a resumed run is told in place of AGENT_PROMPT. A command-line note goes after it.
# RESUME_PROMPT="Cadgentic is resuming this session to carry on with {key}, and the run is still unattended. What stopped it last time may have been dealt with, so check that first. Then pick up where you stopped and see the ticket through. If the same thing still stops you, say so and end the run."
